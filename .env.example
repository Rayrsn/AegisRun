# ==============================================================================
# AegisRun Environment Configuration Example
# Copy to `.env` for local runs (all values below match code defaults).
# ==============================================================================

# ------------------------------------------------------------------------------
# Tier 1: Rust Sandbox Worker Daemon (daemon-rs)
# ------------------------------------------------------------------------------
WORKER_NODE_ID=aegis-worker-1
GRPC_LISTEN_ADDR=0.0.0.0:50051
METRICS_LISTEN_ADDR=0.0.0.0:9091
AEGIS_CGROUP_ROOT=/sys/fs/cgroup
AEGIS_CGROUP_SLICE=/sys/fs/cgroup/aegis.slice
AEGIS_SANDBOX_DIR=/run/aegis/sandboxes
AEGIS_ROOTFS_DIR=/var/lib/aegis/rootfs
AEGIS_MAX_SANDBOXES=64
AEGIS_EXEC_CONCURRENCY=8
RUST_LOG=info

# ------------------------------------------------------------------------------
# Tier 2: Go Control Plane & API Gateway (control-go)
# ------------------------------------------------------------------------------
AEGIS_HTTP_ADDR=:8080
AEGIS_POSTGRES_DSN=postgres://aegis:aegis@localhost:5432/aegisrun?sslmode=disable
AEGIS_REDIS_ADDR=localhost:6379
AEGIS_REDIS_PASSWORD=
AEGIS_REDIS_DB=0
# Comma-separated worker_id=host:port entries for least-loaded routing & failover
AEGIS_WORKERS=worker-1=localhost:50051
# Comma-separated token:tenant_id pairs accepted as `Authorization: Bearer <token>`
AEGIS_API_KEYS=aegis-dev-token:default
AEGIS_RATE_LIMIT_RPS=50
AEGIS_RATE_LIMIT_BURST=100
AEGIS_MAX_ACTIVE_PER_TENANT=32
AEGIS_HEARTBEAT_TIMEOUT=5s
AEGIS_APPROVAL_TTL=5m
AEGIS_APPROVAL_REAP_INTERVAL=30s
AEGIS_SHUTDOWN_TIMEOUT=30s
AEGIS_WEBHOOK_TIMEOUT=5s
AEGIS_HTTP_READ_TIMEOUT=15s
AEGIS_HTTP_WRITE_TIMEOUT=0s
AEGIS_HTTP_IDLE_TIMEOUT=60s

# ------------------------------------------------------------------------------
# Tier 3: Python Developer SDK & Benchmarks (sdk-py, benchmarks)
# ------------------------------------------------------------------------------
AEGIS_CONTROL_URL=http://localhost:8080
AEGIS_API_KEY=aegis-dev-token
AEGIS_SANDBOX_ID=
# Optional LLM integration example keys
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
